{
  "name": "dsh-free-academic-search",
  "version": "0.1.0",
  "description": "Free academic search & download plugin for DeepSeek Harness (no API key, no credits)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoujialin1997/free-academic-search.git"
  },
  "homepage": "https://github.com/zoujialin1997/free-academic-search#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
