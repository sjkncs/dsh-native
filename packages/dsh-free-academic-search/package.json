    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "free-academic-core": "file:../free-academic-core"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
