{
  "name": "free-academic-core",
  "version": "0.1.0",
  "description": "Free academic paper search & download core library: multi-source search, dedupe/merge, PDF text extraction, DOI resolution. No API key, no credits.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoujialin1997/free-academic-search.git"
  },
  "homepage": "https://github.com/zoujialin1997/free-academic-search#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.8",
    "@types/node": "^22.20.0"
  }
}
